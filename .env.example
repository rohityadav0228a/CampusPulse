# ==============================================================================
# CampusPulse - Environment Configuration Template
# ==============================================================================
# NOTE: Standard Spring Boot does NOT automatically read or source .env files
# into its environment. Copying this file to .env alone will NOT configure Spring Boot.
#
# To apply these variables:
# 1. macOS / Linux Shell (zsh / bash):
#      set -a && source .env && set +a
#      OR export individual variables (e.g., export DB_PASSWORD="...")
# 2. Production / Container Deployments:
#      Pass variables via docker run --env-file .env, docker-compose environment,
#      systemd EnvironmentFile=/path/to/.env, or Kubernetes Secret / ConfigMap.
#
# NEVER commit real passwords, tokens, API keys, or private credentials to Git.
# All values shown below are safe defaults or placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL Database Configuration
# ------------------------------------------------------------------------------
# Connection string pointing to MySQL 8+ database schema
DB_URL=jdbc:mysql://localhost:3306/campuspulse_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Dedicated database user credentials
DB_USERNAME=campuspulse_app
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ------------------------------------------------------------------------------
# 2. Administrative Authentication & Access Control
# ------------------------------------------------------------------------------
# Default admin username
ADMIN_USERNAME=admin

# Plaintext admin password (will be BCrypt hashed on startup if provided).
# Leave blank to either use ADMIN_PASSWORD_HASH or let the application auto-generate
# a cryptographically secure temporary one-time password on startup.
# To generate a strong password on macOS/Linux: openssl rand -base64 24
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Optional: Pre-computed BCrypt password hash (takes precedence over ADMIN_PASSWORD if set).
# Example: $2a$10$w...
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------------------------
# 3. Email Notification Configuration (Spring Mail / SMTP)
# ------------------------------------------------------------------------------
# Outgoing SMTP server details (e.g., smtp.gmail.com, smtp.sendgrid.net, or mailhog/local)
SMTP_HOST=localhost
SMTP_PORT=587

# SMTP credentials (leave empty if SMTP_AUTH=false or testing locally)
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# SMTP security options
SMTP_AUTH=false
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=false

# Sender email address displayed to students
MAIL_FROM=noreply@campuspulse.edu

# Base URL used for public complaint tracking hyperlinks in notification emails
APP_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 4. Notification Outbox Worker & Exponential Backoff Retry Policy
# ------------------------------------------------------------------------------
# Master switch for the background email retry worker
NOTIFICATION_RETRY_ENABLED=true

# Polling frequency in milliseconds (default: 60000ms = 1 minute)
NOTIFICATION_RETRY_INTERVAL_MS=60000

# Delay before first retry check after application startup (default: 10000ms = 10s)
NOTIFICATION_RETRY_INITIAL_DELAY_MS=10000

# Maximum delivery attempts before marking a notification as PERMANENTLY_FAILED
NOTIFICATION_RETRY_MAX_ATTEMPTS=3

# Initial retry backoff interval in milliseconds (default: 30000ms = 30s)
NOTIFICATION_RETRY_INITIAL_BACKOFF_MS=30000

# Exponential backoff multiplier (2.0 = 30s -> 60s -> 120s)
NOTIFICATION_RETRY_BACKOFF_MULTIPLIER=2.0

# Maximum ceiling for backoff delay (default: 300000ms = 5 minutes)
NOTIFICATION_RETRY_MAX_BACKOFF_MS=300000

# In-flight lock stale recovery threshold (default: 300000ms = 5 minutes)
NOTIFICATION_RETRY_STALE_THRESHOLD_MS=300000

# ------------------------------------------------------------------------------
# 5. CampusPulse AI Classifier Microservice Integration (Python FastAPI)
# ------------------------------------------------------------------------------
# HTTP URL where the local FastAPI microservice is hosted
AI_SERVICE_URL=http://127.0.0.1:8000

# Connection timeout to AI service in milliseconds (fail-safe fallback)
AI_CONNECT_TIMEOUT_MS=2000

# Read/response timeout to AI service in milliseconds
AI_READ_TIMEOUT_MS=3000

# ------------------------------------------------------------------------------
# 6. Service Level Agreement (SLA) Targets & Automated Escalation
# ------------------------------------------------------------------------------
# Target response deadline in hours from complaint submission (first status change)
SLA_RESPONSE_HOURS=24

# Target resolution deadline in hours from complaint submission (RESOLVED status)
SLA_RESOLUTION_HOURS=72

# Advance warning threshold before deadline expiration in hours
SLA_APPROACHING_HOURS=6

# Timezone used for calculating and evaluating SLA timestamps
SLA_TIMEZONE=Asia/Kolkata

# Destination email address for automated SLA escalation alerts
ADMIN_ESCALATION_EMAIL=admin@campuspulse.edu

# Master switch for the background SLA escalation scheduler
SLA_ESCALATION_ENABLED=true

# Escalation check evaluation interval in milliseconds (default: 60000ms = 1 minute)
SLA_ESCALATION_INTERVAL_MS=60000

# Delay before first SLA check after startup in milliseconds (default: 15000ms = 15s)
SLA_ESCALATION_INITIAL_DELAY_MS=15000
